# Root deploy config for docker-compose. Copy to .env and fill in.
#   cp .env.example .env && docker compose up -d --build
# .env is git-ignored — never commit real secrets.

# --- Public address (Caddy/TLS) ---
# A real domain gets an automatic Let's Encrypt cert; `localhost` uses Caddy's
# internal self-signed CA (browser will warn — fine for LAN/testing).
SITE_ADDRESS=localhost

# --- PostgreSQL ---
POSTGRES_USER=zeiterfassung
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=zeiterfassung

# --- Backend app settings (ZEITERFASSUNG_ prefix; passed through to the API) ---
# DATABASE_URL and REDIS_URL are set automatically by docker-compose to point at
# the postgres/redis services — do NOT set them here.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
ZEITERFASSUNG_JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING
ZEITERFASSUNG_ENVIRONMENT=production
ZEITERFASSUNG_DEBUG=false
# JSON array — restrict to your real origin(s) in production.
ZEITERFASSUNG_CORS_ORIGINS=["https://localhost"]

# --- Observability (optional) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
