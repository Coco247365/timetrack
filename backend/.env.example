# Backend-Konfiguration — nach .env kopieren und ausfüllen.
# Alle App-Settings nutzen den Prefix ZEITERFASSUNG_ (siehe config.py).
# (SENTRY_DSN ist die einzige Ausnahme: wird ohne Prefix gelesen.)
#
# Tipp: `scripts/dev-bootstrap.sh` (Repo-Root) erzeugt eine lauffähige .env
# automatisch inkl. generiertem JWT-Secret.

# --- Datenbank / Cache ---
ZEITERFASSUNG_DATABASE_URL=postgresql+asyncpg://zeiterfassung:zeiterfassung@127.0.0.1:5432/zeiterfassung
ZEITERFASSUNG_REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# Langen Zufallswert generieren: python -c "import secrets; print(secrets.token_urlsafe(64))"
# ACHTUNG: Die App verweigert außerhalb von Debug den Start, wenn das Secret
# dem Code-Default entspricht oder kürzer als 32 Zeichen ist.
ZEITERFASSUNG_JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_A_LONG_RANDOM_STRING
ZEITERFASSUNG_JWT_ALGORITHM=HS256
ZEITERFASSUNG_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
ZEITERFASSUNG_JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- App-Defaults ---
ZEITERFASSUNG_DEFAULT_TIMEZONE=Europe/Berlin
ZEITERFASSUNG_DEFAULT_BUNDESLAND=HH
# JSON-Array. Prod läuft same-origin hinter Caddy und braucht kein CORS;
# der Code-Default ist localhost:3000 (Dev). Nur setzen, wenn wirklich ein
# fremder Origin zugreifen soll.
ZEITERFASSUNG_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ZEITERFASSUNG_ENVIRONMENT=development
ZEITERFASSUNG_DEBUG=false

# --- Hatchet Workflow-Engine (optional; ohne Token deaktiviert) ---
ZEITERFASSUNG_HATCHET_TOKEN=
ZEITERFASSUNG_HATCHET_HOST_PORT=localhost:7077
ZEITERFASSUNG_HATCHET_SERVER_URL=http://localhost:7078
ZEITERFASSUNG_HATCHET_TLS_STRATEGY=none

# --- DATEV LODAS Export ---
ZEITERFASSUNG_DATEV_BERATER_NR=
ZEITERFASSUNG_DATEV_MANDANTEN_NR=
ZEITERFASSUNG_DATEV_DAILY_HOURS=7.7

# --- Observability (optional) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
